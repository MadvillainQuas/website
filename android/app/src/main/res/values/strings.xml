<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">EPINOIΛ</string>

    <!--
        DIGITAL ASSET LINKS, APP SIDE: this app may handle every URL on the apex host.
        The apex, never www: www 301-redirects, and a redirect fails verification.
        The site side is /.well-known/assetlinks.json, which must list this package and the
        signing key's SHA-256 fingerprint.
    -->
    <string name="asset_statements" translatable="false">
        [{
            \"relation\": [\"delegate_permission/common.handle_all_urls\"],
            \"target\": {
                \"namespace\": \"web\",
                \"site\": \"https://prophesyscouting.co.uk\"}
        }]
    </string>

    <!-- Notification channel. The name is what Settings shows under Notification categories. -->
    <string name="channel_alerts_name">Game alerts</string>
    <string name="channel_alerts_description">Reminders, lineups, half-time and results for the games you follow.</string>

    <!-- Chrome dialog (once, when Chrome is missing or disabled) -->
    <string name="chrome_dialog_title">EPINOIΛ needs Chrome</string>
    <string name="chrome_dialog_message">EPINOIΛ runs on Google Chrome, which gives it its splash screen and game alerts. Chrome is not installed or is turned off on this phone.\n\nGet or enable Chrome, then open EPINOIΛ again. You can carry on without it, but game alerts will not work.</string>
    <string name="chrome_dialog_get">Get Chrome</string>
    <string name="chrome_dialog_continue">Continue anyway</string>

    <!-- Notification pre-prompt (first launch, Android 13+) -->
    <string name="prompt_title">Game alerts</string>
    <string name="prompt_body">EPINOIΛ can tell you when a game you follow is about to start, when lineups are in, at half-time and at the final whistle.\n\nAndroid will ask next. Choose Allow to get them. You can change this at any time.</string>
    <string name="prompt_allow">Continue</string>
    <string name="prompt_later">Not now</string>

    <!-- Notification settings screen -->
    <string name="settings_title">Notification settings</string>
    <string name="settings_intro">What decides whether a game alert pops up on this phone.</string>
    <string name="settings_row_app">EPINOIΛ notifications</string>
    <string name="settings_row_channel">Game alerts</string>
    <string name="settings_row_dnd">Do Not Disturb</string>
    <string name="settings_row_battery">Battery</string>
    <string name="settings_on">Allowed</string>
    <string name="settings_off">Blocked</string>
    <string name="settings_importance_high">Alert, pops up</string>
    <string name="settings_importance_default">Alert, no pop-up</string>
    <string name="settings_importance_low">Silent</string>
    <string name="settings_importance_none">Off</string>
    <string name="settings_importance_unknown">Not set up yet</string>
    <string name="settings_dnd_off">Off</string>
    <string name="settings_dnd_on">On: alerts may be held back</string>
    <string name="settings_battery_restricted">Restricted: alerts are blocked</string>
    <string name="settings_battery_optimised">Optimised: alerts may be late</string>
    <string name="settings_battery_unrestricted">Unrestricted</string>
    <string name="settings_open_app">Open notification settings</string>
    <string name="settings_open_channel">Open Game alerts settings</string>
