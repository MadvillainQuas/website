<?xml version="1.0" encoding="utf-8"?>
<!--
    ADAPTIVE LAUNCHER ICON, Android 8+: the blue EPINOIΛ logo; themed on Android 13+.
    The whole logo is the background layer (tools/build-android-icons.py draws it edge to edge), so
    the foreground is empty: the wordmark's glow cannot be cut out cleanly as a separate layer.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
