<?xml version="1.0" encoding="utf-8"?>
<!--
    THE SPLASH MARK, in the kit's light-theme lume on HOME's #f3faf6 (the colour comes from the
    splash background, not from here). Three uses, one drawable:
    - the TWA splash (SPLASH_IMAGE_DRAWABLE): androidbrowserhelper rasterises it at its 108dp
      intrinsic size and hands the bitmap to Chrome, so it must stay a fixed-size vector;
    - the Android 12+ system splash icon (values-v31), which keeps the centre two-thirds visible;
      the mark sits well inside that;
    - the notification pre-prompt's header image.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0c7a54"
        android:pathData="M54,30 L72,70 L64,70 L54,47.5 L44,70 L36,70 Z" />
    <path
        android:fillColor="#0c7a54"
        android:pathData="M36,76 L72,76 L72,80 L36,80 Z" />
</vector>
