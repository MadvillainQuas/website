# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*~

# Local secrets / experiments — keep them out of the public repo
*.local.json
*.secret
.env
.env.*

# Supabase CLI local state (link info, cached versions) — machine-specific
supabase/.temp/
supabase/.branches/

# guard.yml's PGlite steps run `npm i --no-save @electric-sql/pglite` locally too —
# never committed, always reinstalled
node_modules/

# Claude Code session state
.claude/

# Editor backups
*.bak-*

# the transfer matrix's built data (tools/build-transfer.mjs): members' files, uploaded to the private bucket by
# tools/upload-transfer.mjs, never committed and never published
transfermatrix/build/

# ingest: raw feed payloads are archives, not source (bundles stay as fixtures)
data/ingest-fixtures/*.raw.json
data/ingest-raw/
__pycache__/

# Android app. THE SIGNING KEY NEVER ENTERS THIS REPO: it is public, and a leaked
# key lets anyone ship an "update" to every installed Epinoia app. CI decodes the
# key into $RUNNER_TEMP, outside the checkout. Build output and machine paths stay
# local too.
*.jks
*.keystore
android/.gradle/
android/**/build/
android/local.properties
google-services.json

# reset_league.py backups hold player records: never committed
data/reset/

# What wins builder: the private store and --local output (members-only data) when run here
.cache/

# ncaa.com documents fetched by scripts/ingest/ncaa_accuracy.py: never published from this public repository
# (the sample's documents are kept in the scraper's private checkout, validation/ncaa/captures_d2)
scripts/ingest/data/ncaa/captures/
