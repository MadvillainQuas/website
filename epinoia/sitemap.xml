<?xml version="1.0" encoding="UTF-8"?>
<!--
  The public section's stable entry points: the SOURCE of sitemap-static.xml.

  On every deploy tools/build-seo.py turns the sitemap into an INDEX (this address, /epinoia/sitemap.xml) of three
  files: sitemap-static.xml (the entries below, with a <lastmod> from the data where the page changes with it),
  sitemap-entities.xml (every league, club and player: p/<name>.html, t/<slug>.html, l/<slug>.html, and the
  Japanese and Spanish copies with their hreflang alternates) and sitemap-games.xml (the box score pages of the
  last and next 30 days: game/<id>.html). None of those is listed here. Until that runs (a local checkout) this
  file is a valid sitemap of its own.

  Only pages that may be indexed and are not disallowed in /robots.txt belong here (tools/build_seo_test.py checks), and
  never an address that forwards somewhere else (/epinoia/ and /epinoia/contact/).
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- the site's front door (2026-10-06) and the scouting services; the bare /epinoia/ now forwards to HOME, so it is not listed -->
  <url>
    <loc>https://prophesyscouting.co.uk/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/prophesy/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/home/</loc>
    <changefreq>hourly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/games/</loc>
    <changefreq>hourly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/stats/</loc>
    <changefreq>daily</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/stats/wowy/</loc>
    <changefreq>daily</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/scouting/</loc>
    <changefreq>daily</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/video/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
  <!-- The pitch page, and the widget gallery it sends people to. Both are
       static prose rather than league data, so they are the only two pages
       here a search engine can usefully rank on their own words — and they
       are what a competition or a partner is looking for when they find us
       without already knowing the name. -->
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/learn/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/embed/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/api/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
</urlset>
