<?xml version="1.0" encoding="UTF-8"?>
<!--
  The public section's stable entry points.

  Per-game and per-player URLs are deliberately absent: they are query-string
  pages served from one file, and their content lives in Supabase rather than
  in this repository, so there is nothing here to enumerate at build time. The
  real fix is the static per-game pages the publish queue commits at finalise —
  those get their own directory, their own baked tags, and belong in a sitemap
  generated alongside them. Listing dynamic URLs here that a crawler cannot
  distinguish from one another would be worse than listing none.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/</loc>
    <changefreq>hourly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/home/</loc>
    <changefreq>hourly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/games/</loc>
    <changefreq>hourly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/stats/</loc>
    <changefreq>daily</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/stats/wowy/</loc>
    <changefreq>daily</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/scouting/</loc>
    <changefreq>daily</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/video/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
  <!-- The pitch page, and the widget gallery it sends people to. Both are
       static prose rather than league data, so they are the only two pages
       here a search engine can usefully rank on their own words — and they
       are what a competition or a partner is looking for when they find us
       without already knowing the name. -->
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/learn/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://prophesyscouting.co.uk/epinoia/embed/</loc>
