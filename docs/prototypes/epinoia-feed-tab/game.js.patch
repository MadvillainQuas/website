+/* A FED GAME UPDATES WHEN THE WORKER RUNS, not when a scorer taps. The
+   worker re-fetches a live game on every poll and upserts game_advanced, so
+   the page listens to that row: realtime (postgres_changes — the first such
+   subscription on the site; the table is in the publication, RLS allows the
+   read) with a slow poll behind it, paused while the tab is hidden, exactly
+   like watchGameStatus. */
+const FEED_POLL_MS = 60000;
+function watchFeed() {
+  if (mode !== 'supabase' || !gameId) return;
+  const apply = row => {
+    if (!row || !window.S) return;
+    if (window.S.advanced && window.S.advanced.computed_at === row.computed_at) return;
+    window.S.advanced = row;
+    if (row.status === 'final' && window.S.status !== 'final') { window.S.status = 'final'; setStatus('final'); }
+    lastBodyKey = '';
+    if (fTab === 'feed') renderBody();
+  };
+  try {
+    const sb = window.epinoiaClient ? epinoiaClient() : null;
+    if (sb) {
+      sb.channel('feed:' + gameId)
+        .on('postgres_changes', { event: '*', schema: 'public', table: 'game_advanced', filter: 'game_id=eq.' + gameId },
+            m => apply(m.new))
+        .subscribe();
+    }
+  } catch (e) { console.warn('[feed] realtime unavailable', e); }
+  let missed = false;
+  document.addEventListener('visibilitychange', () => { if (!document.hidden && missed) { missed = false; poll(); } });
+  async function poll() {
+    if (!window.S || window.S.status === 'final') return;
+    try {
+      const rows = await api(`game_advanced?game_id=eq.${encodeURIComponent(gameId)}&select=*&limit=1`);
+      if (rows.length) apply(rows[0]);
+    } catch (_) { /* a blip is not a verdict */ }
+  }
+  setInterval(() => { if (document.hidden) { missed = true; return; } poll(); }, FEED_POLL_MS);
+}
+
+/* Fixture loader for ?g=fixture:<id> — see boot(). Relative to the site root
+   so it works from /epinoia/game/ on the dev server and on Pages alike. */
+async function loadFixture(id) {
+  const r = await fetch('../../data/ingest-fixtures/' + encodeURIComponent(id) + '.json', { cache: 'no-store' });
+  if (!r.ok) throw new Error('fixture ' + id + ' not found (' + r.status + ')');
+  const b = await r.json();
+  const home = (b.team && b.team.home) || {}, away = (b.team && b.team.away) || {};
+  return {
+    teams: [{ name: home.team || b.home_name || 'home', color: '#93f2bf', players: [] },
+            { name: away.team || b.away_name || 'away', color: '#8ff5ff', players: [] }],
+    starters: [[], []], events: [], advanced: Object.assign({ computed_at: new Date().toISOString() }, b),
+    period: 4, clockMs: 0, phase: b.status === 'final' ? 'final' : 'game', status: b.status || 'final',
+    competition: 'Fixture · ' + (b.adapter || 'ingest'), leagueSlug: null, venue: null, video: null,
+    details: { officials: {} },
+    meta: { status: b.status || 'final', home_score: home.points, away_score: away.points,
+            home: { name: home.team }, away: { name: away.team } }
+  };
+}
